<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- HEADER CON LOGO Y ESTADO -->
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_gateway" />

        <!-- ESTADO -->
        <TextView
            android:id="@+id/tvStatus"
            android:text="Servicio: DESCONOCIDO"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- BOTONES DE CONTROL EN FILA HORIZONTAL -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnStart"
                android:text="Iniciar"
                android:textSize="13sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#4CAF50"
                android:layout_width="110dp"
                android:layout_height="44dp" />

            <Button
                android:id="@+id/btnStop"
                android:text="Detener"
                android:textSize="13sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#F44336"
                android:layout_width="110dp"
                android:layout_height="44dp" />

            <Button
                android:id="@+id/btnCheckUpdate"
                android:text="Actualizar"
                android:textSize="13sp"
                android:backgroundTint="#2196F3"
                android:layout_width="110dp"
                android:layout_height="44dp" />

        </LinearLayout>

        <!-- CARACTERÍSTICAS DE LA MÁQUINA -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="#EEF2FF">

            <TextView
                android:text="🖥️ Características de la Máquina"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvMachineNo"
                        android:text="N° Máquina: —"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvMachineName"
                        android:text="Nombre: —"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvWgIp"
                        android:text="IP Visor: —"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvWgPublicKey"
                        android:text="Clave Pública: —"
                        android:textSize="10sp"
                        android:textColor="#555555"
                        android:fontFamily="monospace"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- SEPARATOR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- CONFIGURACIÓN DE PANELES: ENTRANTE + SALIENTE -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- CONEXIÓN ENTRANTE (Panel de Origen) -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#F1F8F1">

            <TextView
                android:text="📥 Conexión Entrante (Panel de Origen)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgInputSource"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbInputPanel1"
                    android:text="Panel 1 (https://gsvden.coffeeji.com)"
                    android:textSize="10sp"
                    android:checked="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <RadioButton
                    android:id="@+id/rbInputPanel2"
                    android:text="Panel 2 (https://maquinas.powerboxchile.cl)"
                    android:textSize="10sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </RadioGroup>
        </LinearLayout>

        <!-- DIVISOR VERTICAL -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <!-- CONEXIÓN SALIENTE (Panel que obtiene datos) -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#EBF3FB">

            <TextView
                android:text="📤 Conexión Saliente (Panel que obtiene datos)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swOutputPanel1"
                android:text="Panel 1 (https://gsvden.coffeeji.com)"
                android:textSize="10sp"
                android:checked="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swOutputPanel2"
                android:text="Panel 2 (https://maquinas.powerboxchile.cl)"
                android:textSize="10sp"
                android:checked="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- SEPARATOR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- DIAGNÓSTICO DE PANELES -->
    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#FAFAFA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="⚙️ Diagnóstico"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvPendingCount"
                android:text="Sin pendientes"
                android:textSize="11sp"
                android:textColor="#757575"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvConfigSummary"
            android:text="Cargando configuración..."
            android:textSize="11sp"
            android:textColor="#555555"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- SEPARATOR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- LOG VIEWER SECTION -->
    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HEADER DE LOGS -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="📊 Event Log"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <!-- BOTÓN LIMPIAR -->
            <Button
                android:id="@+id/btnClearLogs"
                android:text="🗑️ Limpiar"
                android:textSize="12sp"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#FF9800"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp" />

            <!-- BOTÓN EXPORTAR -->
            <Button
                android:id="@+id/btnExportLogs"
                android:text="💾 Exportar"
                android:textSize="12sp"
                android:padding="8dp"
                android:backgroundTint="#2196F3"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp" />
        </LinearLayout>

        <!-- SCROLL VIEW CON LOGS -->
        <ScrollView
            android:id="@+id/scrollLogs"
            android:background="#263238"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvLogs"
                android:text="Esperando eventos...\n"
                android:textSize="11sp"
                android:textColor="#B0BEC5"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <!-- CONTADOR DE LOGS -->
        <TextView
            android:id="@+id/tvLogCount"
            android:text="0 eventos"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- VERSION FOOTER AT THE BOTTOM -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvVersion"
            android:text="Powerbox Gateway v2.5"
            android:textSize="10sp"
            android:textColor="#757575"
            android:textStyle="italic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
